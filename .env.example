# Token du bot Discord (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Clé API Google Gemini, gratuite (aistudio.google.com/apikey) - moteur principal de conversation + analyse d'images/gifs
GEMINI_API_KEY=

# Modèle Gemini à utiliser (facultatif)
GEMINI_MODEL=gemini-3.5-flash

# Clé API Groq, gratuite (console.groq.com > API Keys) - utilisée en secours si Gemini échoue ou n'est pas configuré
GROQ_API_KEY=

# Modèle Groq à utiliser (facultatif)
GROQ_MODEL=groq/compound-mini

# Nombre max de tokens par réponse (facultatif)
MAX_TOKENS=1024

# Nombre de messages gardés en mémoire par salon pour le contexte (facultatif)
MAX_HISTORY=20

# Nombre d'extraits gardés par personne (mémoire partagée entre tous les salons,
# pour se souvenir des gens dans de futures conversations) (facultatif)
MAX_USER_MEMORY=40

# Répondre à TOUS les messages d'un salon sans être mentionné (true/false, défaut true)
REPLY_TO_ALL=true

# Délai mini entre deux réponses spontanées dans un même salon, en ms (0 = désactivé).
# Ignoré quand on mentionne le bot ou en DM. Utile pour limiter les appels API sur un salon actif.
REPLY_COOLDOWN_MS=0

# Préfixes de messages à ignorer quand REPLY_TO_ALL est actif (commandes d'autres bots),
# séparés par des virgules. Mettre une valeur vide pour ne rien ignorer.
IGNORE_PREFIXES=!,/,.,;,$,-,+
